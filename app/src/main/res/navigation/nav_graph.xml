<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/selectionFragment">

    <fragment
        android:id="@+id/selectionFragment"
        android:name="com.example.thousandcourses.ui.onboarding.SelectionFragment"
        android:label="Выбор версии">
        <action
            android:id="@+id/action_selection_to_onboarding"
            app:destination="@id/onboardingFragment" />

    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.thousandcourses.ui.onboarding.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_onboarding">

        <action
            android:id="@+id/action_onboarding_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.thousandcourses.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />

        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.thousandcourses.ui.register.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">

        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>


    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.thousandcourses.ui.home.HomeFragment"
        android:label="Главная"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_courseDetailsFragment"
            app:destination="@id/courseDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.thousandcourses.ui.home.favorite.FavoritesFragment"
        android:label="Избранное"
        tools:layout="@layout/fragment_favorites">
        <action
            android:id="@+id/action_favoritesFragment_to_courseDetailsFragment"
            app:destination="@id/courseDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.example.thousandcourses.ui.home.account.AccountFragment"
        android:label="Аккаунт"
        tools:layout="@layout/fragment_account">
    </fragment>

    <fragment
        android:id="@+id/courseDetailsFragment"
        android:name="com.example.thousandcourses.ui.home.details.CourseDetailsFragment"
        android:label="Детали курса"
        tools:layout="@layout/fragment_course_details">
        <argument
            android:name="courseId"
            app:argType="string" />
    </fragment>

</navigation>